{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "background": "#BB9AF7",
          "foreground": "#16161E",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ .UserName }} ",
          "trailing_diamond": "\ue0b0",
          "type": "session"
        },
        {
          "background": "#7AA2F7",
          "foreground": "#16161E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "style": "folder"
          },
          "style": "powerline",
          "template": " \uea83  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#E0AF68",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#F7768E{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F7768E{{ end }}",
            "{{ if gt .Ahead 0 }}#7DCFFF{{ end }}",
            "{{ if gt .Behind 0 }}#7DCFFF{{ end }}"
          ],
          "foreground": "#16161E",
          "leading_diamond": "\ue0b6",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "git"
        },
        {
          "background": "#41A6B5",
          "foreground": "#16161E",
          "powerline_symbol": "\ue0b0",
          "options": { "fetch_version": true },
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#7DCFFF",
          "foreground": "#16161E",
          "powerline_symbol": "\ue0b0",
          "options": { "fetch_version": true },
          "style": "powerline",
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "go"
        },
        {
          "background": "#E0AF68",
          "foreground": "#16161E",
          "powerline_symbol": "\ue0b0",
          "options": { "display_mode": "files" },
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "background": "#363B54",
          "foreground": "#ACB0D0",
          "options": { "always_enabled": true },
          "style": "plain",
          "template": "<transparent>\ue0b0</> \ueba2 {{ .FormattedMs }}\u2800",
          "type": "executiontime"
        },
        {
          "background": "#41A6B5",
          "background_templates": ["{{ if gt .Code 0 }}#F7768E{{ end }}"],
          "foreground": "#ffffff",
          "options": { "always_enabled": true },
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \ue23a ",
          "trailing_diamond": "\ue0b4",
          "type": "status"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "background": "#7AA2F7",
          "foreground": "#16161E",
          "style": "plain",
          "template": "<#7AA2F7,transparent>\ue0b6</> \uf489 {{ .Name }} <transparent,#7AA2F7>\ue0b2</>",
          "type": "shell"
        },
        {
          "background": "#BB9AF7",
          "foreground": "#16161E",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "style": "powerline",
          "template": " \ueab0 {{ (div .PhysicalPercentUsed 1) }}% ",
          "type": "sysinfo"
        },
        {
          "background": "#E0AF68",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#41A6B5{{end}}",
            "{{if eq \"Discharging\" .State.String}}#F7768E{{end}}"
          ],
          "foreground": "#16161E",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}\uf295 ",
          "type": "battery"
        },
        {
          "background": "#363B54",
          "foreground": "#ACB0D0",
          "invert_powerline": true,
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ]
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}
